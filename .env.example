# Toolkit settings. ./setup.sh copies this to .env and generates unique secrets.

# Host interface for published ports. 127.0.0.1 = this machine only.
# Use 0.0.0.0 (or a LAN IP) to reach the tools from other machines — firewall accordingly.
BIND_ADDRESS=127.0.0.1
# Hostname the dashboard uses in its tool links (e.g. a server's LAN name or IP).
LINK_HOST=localhost
TIME_ZONE=UTC

# --- Optional HTTPS reverse proxy (see compose.proxy.yml) ---
PROXY_ENABLED=false
# Tools are served at <name>.${TOOLKIT_DOMAIN}, e.g. toolkit.tools.example.com
TOOLKIT_DOMAIN=tools.example.com
# External Docker network shared with your reverse proxy
PROXY_NETWORK=proxy
# Subnet of that network, trusted by Snipe-IT for X-Forwarded-* headers
PROXY_TRUSTED_SUBNET=172.16.0.0/12

# --- Ports and image versions ---
DASHBOARD_PORT=8080
IT_TOOLS_PORT=8081
IT_TOOLS_TAG=latest
CYBERCHEF_PORT=8082
CYBERCHEF_TAG=latest
UPTIME_KUMA_PORT=3001
UPTIME_KUMA_TAG=2
STIRLING_PDF_PORT=8083
STIRLING_PDF_IMAGE=stirlingtools/stirling-pdf@sha256:c195925341aa35ee5932d9c225edef48a92e46a1280963180d79619cb5f29e6e
GATUS_PORT=8084
GATUS_TAG=stable
NETBOX_PORT=8000
NETBOX_TAG=v4.7-5.1.1
SNIPEIT_PORT=8001
SNIPEIT_TAG=v8.7.0
SOCRATES_PORT=8085
SOCRATES_TAG=main
CONVERTX_PORT=8087
CONVERTX_TAG=latest
MYIP_PORT=8088
MYIP_TAG=latest

# --- Application settings and secrets (placeholders are replaced by setup.sh) ---
STIRLING_ADMIN_USER=admin
STIRLING_ADMIN_PASSWORD=CHANGE_ME_NOW
STIRLING_LOCALE=en-US
STIRLING_MAX_FILE_SIZE_MB=100

NETBOX_ALLOWED_HOSTS=localhost 127.0.0.1
NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
NETBOX_DB_PASSWORD=CHANGE_ME_NETBOX_DATABASE_PASSWORD
NETBOX_REDIS_PASSWORD=CHANGE_ME_NETBOX_REDIS_PASSWORD
NETBOX_REDIS_CACHE_PASSWORD=CHANGE_ME_NETBOX_CACHE_PASSWORD
NETBOX_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_50_RANDOM_CHARACTERS
NETBOX_API_TOKEN_PEPPER=CHANGE_ME_NETBOX_API_TOKEN_PEPPER

SNIPEIT_APP_KEY=CHANGE_ME_WITH_ARTISAN_GENERATED_KEY
SNIPEIT_LOCALE=en-US
SNIPEIT_DB_NAME=snipeit
SNIPEIT_DB_USER=snipeit
SNIPEIT_DB_PASSWORD=CHANGE_ME_SNIPEIT_DATABASE_PASSWORD
SNIPEIT_DB_ROOT_PASSWORD=CHANGE_ME_SNIPEIT_ROOT_PASSWORD

CONVERTX_JWT_SECRET=CHANGE_ME_CONVERTX_JWT_SECRET
# Set true only if you reach ConvertX over plain HTTP from another machine
CONVERTX_HTTP_ALLOWED=false
CONVERTX_AUTO_DELETE_HOURS=24

# Optional MaxMind GeoLite2 credentials for MyIP's local geolocation API
MYIP_MAXMIND_ACCOUNT_ID=
MYIP_MAXMIND_LICENSE_KEY=
MYIP_MAXMIND_AUTO_UPDATE=false
